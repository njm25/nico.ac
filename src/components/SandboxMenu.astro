---
---

<div class="sandbox-menu" id="sandbox-menu">
	<button class="sandbox-trigger" id="sandbox-trigger" aria-label="sandbox tools" aria-haspopup="true" aria-expanded="false">
		<span class="sandbox-hamburger">
			<span></span>
			<span></span>
			<span></span>
		</span>
	</button>
	<div class="sandbox-flyout" role="menu">
		<button class="sandbox-tool" id="sandbox-tool-beachball" role="menuitem" aria-label="spawn beach ball">
			<span class="tool-icon beachball-icon"></span>
		</button>
		<button class="sandbox-tool" id="sandbox-tool-clear" role="menuitem" aria-label="clear beach balls">
			<span class="tool-icon trash-icon" aria-hidden="true">
				<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
					<path d="M3 6h18" />
					<path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" />
					<path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6" />
					<path d="M10 11v6" />
					<path d="M14 11v6" />
				</svg>
			</span>
		</button>
	</div>
</div>

<style>
	.sandbox-menu {
		position: fixed;
		left: 1.25rem;
		top: 50%;
		transform: translateY(-50%);
		z-index: 9999;
		font-family: var(--mono);
	}

	/* bridges the gap between trigger and flyout so hover doesn't drop between them */
	.sandbox-menu::after {
		content: '';
		position: absolute;
		left: 100%;
		top: 50%;
		transform: translateY(-50%);
		width: 0.6rem;
		height: 3rem;
	}

	.sandbox-trigger {
		width: 2.25rem;
		height: 2.25rem;
		border-radius: 50%;
		background: var(--bg-raised);
		border: 1px solid var(--border);
		cursor: pointer;
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 0;
		transition: border-color 0.15s ease, background 0.15s ease;
	}

	.sandbox-trigger:hover,
	.sandbox-menu.open .sandbox-trigger {
		border-color: var(--accent);
	}

	.sandbox-hamburger {
		display: flex;
		flex-direction: column;
		justify-content: center;
		gap: 0.2rem;
		width: 0.9rem;
	}

	.sandbox-hamburger span {
		display: block;
		height: 1.5px;
		width: 100%;
		background: var(--text-faint);
		transition: background 0.15s ease;
	}

	.sandbox-trigger:hover .sandbox-hamburger span,
	.sandbox-menu.open .sandbox-hamburger span {
		background: var(--accent);
	}

	.sandbox-flyout {
		position: absolute;
		left: calc(100% + 0.6rem);
		top: 50%;
		transform: translateY(-50%);
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
		background: var(--bg-raised);
		border: 1px solid var(--border);
		border-radius: 6px;
		padding: 0.35rem;
		opacity: 0;
		visibility: hidden;
		transition: opacity 0.15s ease;
		white-space: nowrap;
	}

	.sandbox-menu:hover .sandbox-flyout,
	.sandbox-menu.open .sandbox-flyout {
		opacity: 1;
		visibility: visible;
	}

	.sandbox-tool {
		display: flex;
		align-items: center;
		justify-content: center;
		background: transparent;
		border: none;
		border-radius: 4px;
		width: 2rem;
		height: 2rem;
		padding: 0;
		cursor: pointer;
		color: var(--text-dim);
		transition: background 0.15s ease, color 0.15s ease;
	}

	.sandbox-tool:hover {
		background: var(--bg);
		color: var(--text);
	}

	.tool-icon {
		width: 1rem;
		height: 1rem;
		flex-shrink: 0;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.beachball-icon {
		border-radius: 50%;
		background: conic-gradient(
			#e64545 0deg 60deg,
			#f2f2ef 60deg 90deg,
			#f2a93b 90deg 150deg,
			#f2f2ef 150deg 180deg,
			#4caf7c 180deg 240deg,
			#f2f2ef 240deg 270deg,
			#4a90d9 270deg 330deg,
			#f2f2ef 330deg 360deg
		);
	}

	.trash-icon {
		color: var(--text-dim);
	}

	.sandbox-tool:hover .trash-icon {
		color: var(--text);
	}
</style>

<script type="module">
	import { spawnBeachBall, clearBeachBalls } from '../scripts/beachBall';

	const menu = document.getElementById('sandbox-menu');
	const trigger = document.getElementById('sandbox-trigger');
	const beachBallTool = document.getElementById('sandbox-tool-beachball');
	const clearTool = document.getElementById('sandbox-tool-clear');

	trigger?.addEventListener('click', (e) => {
		e.stopPropagation();
		const isOpen = menu?.classList.toggle('open');
		trigger.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
	});

	document.addEventListener('click', (e) => {
		if (menu && !menu.contains(e.target)) {
			menu.classList.remove('open');
			trigger?.setAttribute('aria-expanded', 'false');
		}
	});

	beachBallTool?.addEventListener('click', () => {
		spawnBeachBall();
		menu?.classList.remove('open');
		trigger?.setAttribute('aria-expanded', 'false');
	});

	clearTool?.addEventListener('click', () => {
		clearBeachBalls();
		menu?.classList.remove('open');
		trigger?.setAttribute('aria-expanded', 'false');
	});
</script>
