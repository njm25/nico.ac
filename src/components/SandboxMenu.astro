---
---

<div class="sandbox-menu" id="sandbox-menu">
	<button class="sandbox-trigger" id="sandbox-trigger" aria-label="sandbox tools" aria-haspopup="true" aria-expanded="false">
		<span class="sandbox-hamburger">
			<span></span>
			<span></span>
			<span></span>
		</span>
	</button>
	<div class="sandbox-flyout" role="menu">
		<button class="sandbox-tool" id="sandbox-tool-beachball" role="menuitem" aria-label="spawn beach ball">
			<span class="tool-icon beachball-icon"></span>
		</button>
		<button class="sandbox-tool" id="sandbox-tool-gun" role="menuitem" aria-label="toggle pistol" aria-pressed="false" data-weapon="pistol">
			<span class="tool-icon gun-icon" aria-hidden="true">
				<!-- "gun" from Font Awesome Free 6.7.2 - CC BY 4.0 - https://fontawesome.com/license/free -->
				<svg viewBox="0 0 576 512" width="17" height="15" fill="currentColor">
					<path d="M528 56c0-13.3-10.7-24-24-24s-24 10.7-24 24l0 8L32 64C14.3 64 0 78.3 0 96L0 208c0 17.7 14.3 32 32 32l10 0c20.8 0 36.1 19.6 31 39.8L33 440.2c-2.4 9.6-.2 19.7 5.8 27.5S54.1 480 64 480l96 0c14.7 0 27.5-10 31-24.2L217 352l104.5 0c23.7 0 44.8-14.9 52.7-37.2L400.9 240l31.1 0c8.5 0 16.6-3.4 22.6-9.4L477.3 208l66.7 0c17.7 0 32-14.3 32-32l0-80c0-17.7-14.3-32-32-32l-16 0 0-8zM321.4 304L229 304l16-64 105 0-21 58.7c-1.1 3.2-4.2 5.3-7.5 5.3zM80 128l384 0c8.8 0 16 7.2 16 16s-7.2 16-16 16L80 160c-8.8 0-16-7.2-16-16s7.2-16 16-16z" />
				</svg>
			</span>
		</button>
		<button class="sandbox-tool" id="sandbox-tool-spray" role="menuitem" aria-label="toggle spray paint" aria-pressed="false">
			<span class="tool-icon spray-icon" aria-hidden="true">
				<!-- "spray-can" from Font Awesome Free 6.7.2 - CC BY 4.0 - https://fontawesome.com/license/free -->
				<svg viewBox="0 0 512 512" width="15" height="15" fill="currentColor">
					<path d="M128 0l64 0c17.7 0 32 14.3 32 32l0 96L96 128l0-96c0-17.7 14.3-32 32-32zM0 256c0-53 43-96 96-96l128 0c53 0 96 43 96 96l0 208c0 26.5-21.5 48-48 48L48 512c-26.5 0-48-21.5-48-48L0 256zm240 80A80 80 0 1 0 80 336a80 80 0 1 0 160 0zM256 64a32 32 0 1 1 64 0 32 32 0 1 1 -64 0zM384 32a32 32 0 1 1 0 64 32 32 0 1 1 0-64zm64 32a32 32 0 1 1 64 0 32 32 0 1 1 -64 0zm32 64a32 32 0 1 1 0 64 32 32 0 1 1 0-64zM448 256a32 32 0 1 1 64 0 32 32 0 1 1 -64 0zM384 128a32 32 0 1 1 0 64 32 32 0 1 1 0-64z" />
				</svg>
			</span>
		</button>
		<button class="sandbox-tool" id="sandbox-tool-undo" role="menuitem" aria-label="undo everything">
			<span class="tool-icon undo-icon" aria-hidden="true">
				<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
					<path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8" />
					<path d="M3 3v5h5" />
				</svg>
			</span>
		</button>
	</div>
</div>

<style>
	.sandbox-menu {
		position: fixed;
		left: 1.25rem;
		top: 50%;
		transform: translateY(-50%);
		z-index: 9999;
		font-family: var(--mono);
	}

	/* bridges the gap between trigger and flyout so hover doesn't drop between them */
	.sandbox-menu::after {
		content: '';
		position: absolute;
		left: 100%;
		top: 50%;
		transform: translateY(-50%);
		width: 0.6rem;
		height: 3rem;
	}

	.sandbox-trigger {
		width: 2.25rem;
		height: 2.25rem;
		border-radius: 50%;
		background: var(--bg-raised);
		border: 1px solid var(--border);
		cursor: pointer;
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 0;
		transition: border-color 0.15s ease, background 0.15s ease;
	}

	.sandbox-trigger:hover,
	.sandbox-menu.open .sandbox-trigger {
		border-color: var(--accent);
	}

	/* keeps the armed state visible once the flyout has closed */
	.sandbox-menu.armed .sandbox-trigger {
		border-color: var(--accent);
		background: color-mix(in srgb, var(--accent) 12%, var(--bg-raised));
	}

	.sandbox-hamburger {
		display: flex;
		flex-direction: column;
		justify-content: center;
		gap: 0.2rem;
		width: 0.9rem;
	}

	.sandbox-hamburger span {
		display: block;
		height: 1.5px;
		width: 100%;
		background: var(--text-faint);
		transition: background 0.15s ease;
	}

	.sandbox-trigger:hover .sandbox-hamburger span,
	.sandbox-menu.open .sandbox-hamburger span,
	.sandbox-menu.armed .sandbox-hamburger span {
		background: var(--accent);
	}

	.sandbox-flyout {
		position: absolute;
		left: calc(100% + 0.6rem);
		top: 50%;
		transform: translateY(-50%);
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
		background: var(--bg-raised);
		border: 1px solid var(--border);
		border-radius: 6px;
		padding: 0.35rem;
		opacity: 0;
		visibility: hidden;
		transition: opacity 0.15s ease;
		white-space: nowrap;
	}

	.sandbox-menu:hover .sandbox-flyout,
	.sandbox-menu.open .sandbox-flyout {
		opacity: 1;
		visibility: visible;
	}

	.sandbox-tool {
		display: flex;
		align-items: center;
		justify-content: center;
		background: transparent;
		border: none;
		border-radius: 4px;
		width: 2rem;
		height: 2rem;
		padding: 0;
		cursor: pointer;
		color: var(--text-dim);
		transition: background 0.15s ease, color 0.15s ease;
	}

	.sandbox-tool:hover {
		background: var(--bg);
		color: var(--text);
	}

	.sandbox-tool.active {
		background: color-mix(in srgb, var(--accent) 16%, var(--bg));
		color: var(--accent);
		box-shadow: inset 0 0 0 1px var(--accent);
	}

	.tool-icon {
		width: 1rem;
		height: 1rem;
		flex-shrink: 0;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.beachball-icon {
		border-radius: 50%;
		background: conic-gradient(
			#e64545 0deg 60deg,
			#f2f2ef 60deg 90deg,
			#f2a93b 90deg 150deg,
			#f2f2ef 150deg 180deg,
			#4caf7c 180deg 240deg,
			#f2f2ef 240deg 270deg,
			#4a90d9 270deg 330deg,
			#f2f2ef 330deg 360deg
		);
	}

	.gun-icon,
	.spray-icon,
	.undo-icon {
		color: inherit;
	}

</style>

<script type="module">
	import { spawnBeachBall, clearBeachBalls } from '../scripts/beachBall';
	import { toggleGun, restorePage, isGunArmed } from '../scripts/gun';
	import { toggleSpray, clearPaint, isSprayOn } from '../scripts/spray';

	const menu = document.getElementById('sandbox-menu');
	const trigger = document.getElementById('sandbox-trigger');
	const beachBallTool = document.getElementById('sandbox-tool-beachball');
	const gunTool = document.getElementById('sandbox-tool-gun');
	const sprayTool = document.getElementById('sandbox-tool-spray');
	const undoTool = document.getElementById('sandbox-tool-undo');

	function closeMenu() {
		menu?.classList.remove('open');
		trigger?.setAttribute('aria-expanded', 'false');
	}

	trigger?.addEventListener('click', (e) => {
		e.stopPropagation();
		const isOpen = menu?.classList.toggle('open');
		trigger.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
	});

	document.addEventListener('click', (e) => {
		if (menu && !menu.contains(e.target)) closeMenu();
	});

	beachBallTool?.addEventListener('click', () => {
		spawnBeachBall();
		closeMenu();
	});

	function syncTool(tool, on) {
		tool?.classList.toggle('active', on);
		tool?.setAttribute('aria-pressed', on ? 'true' : 'false');
	}

	// the trigger keeps showing a tint while any pointer tool is live
	function syncArmed() {
		menu?.classList.toggle('armed', isGunArmed() || isSprayOn());
	}

	// only one pointer tool at a time, or they fight over pointerdown
	function showWeapon(weapon) {
		gunTool.dataset.weapon = weapon;
		gunTool.setAttribute('aria-label', 'toggle ' + weapon);
	}

	// gun.ts owns right click while the gun is drawn, and announces the swap
	window.addEventListener('sandbox:weapon', (e) => showWeapon(e.detail));

	gunTool?.addEventListener('click', () => {
		if (isSprayOn()) syncTool(sprayTool, toggleSpray());
		syncTool(gunTool, toggleGun());
		syncArmed();
		closeMenu();
	});

	sprayTool?.addEventListener('click', () => {
		if (isGunArmed()) syncTool(gunTool, toggleGun());
		syncTool(sprayTool, toggleSpray());
		syncArmed();
		closeMenu();
	});

	undoTool?.addEventListener('click', () => {
		clearBeachBalls();
		restorePage();
		clearPaint();
		closeMenu();
	});
</script>
