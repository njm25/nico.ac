---
import Base from '../layouts/Base.astro';
import { projects } from '../data/projects';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<Base title="nico">
	<p class="prose">
		im a guy interested in computers and whatnot. i like building software and tinkering with
		servers. ive got experience in developing enterprise applications with .net and angular and
		ci/cd experience with aws and github actions. i also have a homelab which i use to run fun little pet
		projects <span class="no-lowercase">:D</span>
	</p>

	<h2>things ive built</h2>
	<div class="list">
		{
			projects.slice(0, 2).map((p) => (
				<a class="list-item" href={p.link} target="_blank" rel="noopener noreferrer">
					<div class="list-item-body">
						<span class="title">{p.title}</span>
						<span class="desc">{p.description}</span>
					</div>
					<span class="meta">{p.year}</span>
				</a>
			))
		}
	</div>

	<h2>blog posts</h2>
	<div class="list">
		{
			posts.slice(0, 3).map((post) => (
				<a class="list-item" href={`/blog/${post.id}`}>
					<div class="list-item-body">
						<span class="title">{post.data.title}</span>
					</div>
					<span class="meta">
						{post.data.date.toLocaleDateString('en-us', { month: 'short', year: 'numeric', timeZone: 'UTC' })}
					</span>
				</a>
			))
		}
	</div>
</Base>
