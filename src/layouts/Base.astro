---
import '../styles/global.css';

interface Props {
	title: string;
	description?: string;
	typewriter?: boolean;
}

const { title, description = 'nico · software engineer', typewriter = true } = Astro.props;
const current = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" href="/favicon.svg" />
		<link rel="alternate" type="application/rss+xml" title="nico · blog" href="/rss.xml" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body>
		<div class="wrap">
			<nav>
				<a class="brand" href="/">nico</a>
				<a href="/" aria-current={current === '/' ? 'page' : undefined}>home</a>
				<a href="/projects" aria-current={current.startsWith('/projects') ? 'page' : undefined}>projects</a>
				<a href="/blog" aria-current={current.startsWith('/blog') ? 'page' : undefined}>blog</a>
			</nav>
			<main>
				<slot />
			</main>
			<footer>
				<span>nico.ac</span>
				<span class="icon-links">
					<a href="https://github.com/njm25" target="_blank" rel="noopener noreferrer" aria-label="github">
						<svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true">
							<path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12" />
						</svg>
					</a>
					<a href="https://www.linkedin.com/in/nicomilette/" target="_blank" rel="noopener noreferrer" aria-label="linkedin">
						<svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true">
							<path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452z" />
						</svg>
					</a>
					<a href="/rss.xml" aria-label="rss">
						<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
							<circle cx="5" cy="19" r="1" fill="currentColor" stroke="none" />
							<path d="M4 4a16 16 0 0 1 16 16" />
							<path d="M4 11a9 9 0 0 1 9 9" />
						</svg>
					</a>
				</span>
			</footer>
		</div>
		{typewriter && (
			<script is:inline>
			(function () {
				if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

				var isReload = false;
				try {
					var navEntry = performance.getEntriesByType('navigation')[0];
					isReload = !!navEntry && navEntry.type === 'reload';
				} catch (e) {}

				var pageKey = 'typed:' + location.pathname;
				try {
					if (!isReload && sessionStorage.getItem(pageKey)) return;
				} catch (e) {}

				var SPEED = 2;

				function tokenize(el) {
					var tokens = [];
					el.childNodes.forEach(function (child) {
						if (child.nodeType === Node.TEXT_NODE) {
							for (var i = 0; i < child.textContent.length; i++) {
								tokens.push({ type: 'char', value: child.textContent[i] });
							}
						} else if (child.nodeType === Node.ELEMENT_NODE) {
							tokens.push({ type: 'html', value: child.outerHTML });
						}
					});
					return tokens;
				}

				function playTokens(el, tokens, onDone) {
					if (!tokens.length) {
						if (onDone) onDone();
						return;
					}
					el.classList.add('typewriter');
					var i = 0;
					function step() {
						if (i < tokens.length) {
							var t = tokens[i];
							if (t.type === 'char') {
								el.appendChild(document.createTextNode(t.value));
							} else {
								el.insertAdjacentHTML('beforeend', t.value);
							}
							i++;
							setTimeout(step, SPEED);
						} else {
							el.classList.remove('typewriter');
							if (onDone) onDone();
						}
					}
					step();
				}

				function lock(el) {
					el.style.minHeight = el.getBoundingClientRect().height + 'px';
				}

				// reserve final box height up front so typing in never shifts layout
				document
					.querySelectorAll('p.prose, .prose p, .prose li, h1, h2, .list-item, .project-card')
					.forEach(lock);

				var targets = document.querySelectorAll(
					'p.prose, .prose p, .prose li, h1, h2, .list-item .title, .list-item .desc, .list-item .meta, .project-card .title, .project-card .desc, .project-card .meta'
				);

				try {
					sessionStorage.setItem(pageKey, '1');
				} catch (e) {}

				// capture each element's content and blank it out immediately so
				// nothing shows before typing starts, then play them all at once
				var queue = Array.prototype.map.call(targets, function (el) {
					var tokens = tokenize(el);
					el.textContent = '';
					return { el: el, tokens: tokens };
				});

				queue.forEach(function (item) {
					playTokens(item.el, item.tokens);
				});
			})();
			</script>
		)}
	</body>
</html>
